{
  "version": 6,
  "configurePresets": [
    {
      "name": "hardening-asan",
      "displayName": "Rule engine hardening with ASan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-hardening-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENGINE_BUILD_TESTS": "ON",
        "ENGINE_ENABLE_IPO": "OFF",
        "ENGINE_USE_ASAN": "ON",
        "ENGINE_VULKAN": "OFF",
        "RULE_ENGINE_ENABLE_C11_PARALLEL": "ON"
      }
    },
    {
      "name": "hardening-ubsan",
      "displayName": "Rule engine hardening with UBSan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-hardening-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENGINE_BUILD_TESTS": "ON",
        "ENGINE_ENABLE_IPO": "OFF",
        "ENGINE_USE_UBSAN": "ON",
        "ENGINE_VULKAN": "OFF",
        "RULE_ENGINE_ENABLE_C11_PARALLEL": "ON"
      }
    },
    {
      "name": "qnx-cross",
      "displayName": "QNX SDP cross build (headless, poll net_loop)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-qnx",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/toolchain-qnx.cmake",
        "QNX_ARCH": "aarch64le",
        "ENGINE_BUILD_TESTS": "ON"
      }
    }
  ]
}

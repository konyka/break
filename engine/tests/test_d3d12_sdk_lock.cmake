# Asserts the D3D12 SDK pins recorded in agility_sdk_lock.txt.
set(LOCK_FILE "${CMAKE_CURRENT_LIST_DIR}/../external/d3d12/agility_sdk_lock.txt")
if(NOT EXISTS "${LOCK_FILE}")
    message(FATAL_ERROR "D3D12 SDK lock file missing: ${LOCK_FILE}")
endif()
file(STRINGS "${LOCK_FILE}" _lines)
set(_winsdk "")
set(_agility "")
set(_nupkg_sha512 "")
set(_dll_sha512 "")
foreach(_line IN LISTS _lines)
    if(_line MATCHES "^winsdk=(.+)$")
        set(_winsdk "${CMAKE_MATCH_1}")
    elseif(_line MATCHES "^agility=(.+)$")
        set(_agility "${CMAKE_MATCH_1}")
    elseif(_line MATCHES "^nupkg_sha512=(.+)$")
        set(_nupkg_sha512 "${CMAKE_MATCH_1}")
    elseif(_line MATCHES "^dll_sha512=(.+)$")
        set(_dll_sha512 "${CMAKE_MATCH_1}")
    endif()
endforeach()
if(NOT _winsdk STREQUAL "10.0.26100.0")
    message(FATAL_ERROR "winsdk pin drift: '${_winsdk}' != 10.0.26100.0")
endif()
if(NOT _agility STREQUAL "1.619.6")
    message(FATAL_ERROR "agility pin drift: '${_agility}' != 1.619.6")
endif()
foreach(_h IN ITEMS _nupkg_sha512 _dll_sha512)
    string(LENGTH "${${_h}}" _h_len)
    if(NOT _h_len EQUAL 128 OR NOT ${_h} MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "lock hash malformed: ${_h}='${${_h}}'")
    endif()
endforeach()
# If the package was already fetched, verify the DLL hash honestly.
set(_dll "${CMAKE_CURRENT_LIST_DIR}/../external/d3d12/agility/build/native/bin/x64/D3D12Core.dll")
if(EXISTS "${_dll}")
    file(SHA512 "${_dll}" _actual)
    if(NOT _actual STREQUAL _dll_sha512)
        message(FATAL_ERROR "D3D12AgilitySDK.dll hash mismatch: ${_actual}")
    endif()
endif()
# Task 3 handoff gate: the Agility SDK export baked into the backend must
# equal the locked package version (agility=1.<SDK>.<rev> -> SDK version
# <SDK>). Without this, D3D12SDKVersion could drift from the hash-locked
# D3D12Core.dll and silently bind a different runtime.
if(NOT _agility MATCHES "^1\\.([0-9]+)\\.[0-9]+$")
    message(FATAL_ERROR "agility pin unparsable: '${_agility}'")
endif()
set(_expected_sdk_version "${CMAKE_MATCH_1}")
set(_backend_src "${CMAKE_CURRENT_LIST_DIR}/../src/rhi/rhi_d3d12.c")
file(READ "${_backend_src}" _backend_text)
if(NOT _backend_text MATCHES "D3D12SDKVersion = ([0-9]+)u")
    message(FATAL_ERROR "D3D12SDKVersion export missing in ${_backend_src}")
endif()
if(NOT CMAKE_MATCH_1 STREQUAL _expected_sdk_version)
    message(FATAL_ERROR
        "D3D12SDKVersion drift: export=${CMAKE_MATCH_1} lock=${_expected_sdk_version}")
endif()
if(NOT _backend_text MATCHES "D3D12SDKPath")
    message(FATAL_ERROR "D3D12SDKPath export missing in ${_backend_src}")
endif()
message(STATUS "D3D12 SDK lock: winsdk=${_winsdk} agility=${_agility} sdk_version=${_expected_sdk_version} hashes=ok")

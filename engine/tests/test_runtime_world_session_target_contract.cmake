if(NOT DEFINED ENGINE_CMAKE OR NOT DEFINED ADAPTER_SOURCE)
    message(FATAL_ERROR "ENGINE_CMAKE and ADAPTER_SOURCE are required")
endif()

file(READ "${ENGINE_CMAKE}" cmake_text)
file(READ "${ADAPTER_SOURCE}" adapter_source)
if(NOT adapter_source MATCHES "queue_config.reserved_control = queue_config.capacity;")
    message(FATAL_ERROR "the adapter queue must reserve its full capacity for control")
endif()
if(NOT adapter_source MATCHES "const u16 kinds\\[1\\] = \\{BREAK_RUNTIME_WORLD_SESSION_CONTROL_KIND\\};")
    message(FATAL_ERROR "the adapter must subscribe only to the external control kind")
endif()
if(adapter_source MATCHES "kinds\\[2\\]" OR
   adapter_source MATCHES "\"world_session\\.publish\"")
    message(FATAL_ERROR "publish-current notices must not become an external Bus kind")
endif()

string(FIND "${adapter_source}"
       "BreakRuntimeError break_runtime_world_session_submit_publish_current(" submit_start)
string(FIND "${adapter_source}" "\nvoid break_runtime_world_session_close(" submit_end)
if(submit_start LESS 0 OR submit_end LESS 0 OR submit_end LESS submit_start)
    message(FATAL_ERROR "missing bounded direct publish-current submit function")
endif()
math(EXPR submit_length "${submit_end} - ${submit_start}")
string(SUBSTRING "${adapter_source}" ${submit_start} ${submit_length} submit_block)
if(NOT submit_block MATCHES
   "view.kind = BREAK_RUNTIME_WORLD_SESSION_PUBLISH_CURRENT_KIND;")
    message(FATAL_ERROR "direct publish-current submit has the wrong kind")
endif()
if(NOT submit_block MATCHES "view.flags = BREAK_RUNTIME_MESSAGE_FLAG_CONTROL;")
    message(FATAL_ERROR "direct publish-current submit must use a control flag")
endif()
if(submit_block MATCHES "break_world_session_")
    message(FATAL_ERROR "direct publish-current submit must not call World Session")
endif()

string(FIND "${adapter_source}" "static BreakRuntimeError runtime_world_publish_connection("
       publish_connection_start)
string(FIND "${adapter_source}" "static bool runtime_world_recompute_continuation("
       publish_connection_end)
if(publish_connection_start LESS 0 OR publish_connection_end LESS 0 OR
   publish_connection_end LESS publish_connection_start)
    message(FATAL_ERROR "missing bounded per-connection publish helper")
endif()
math(EXPR publish_connection_length
     "${publish_connection_end} - ${publish_connection_start}")
string(SUBSTRING "${adapter_source}" ${publish_connection_start}
       ${publish_connection_length} publish_connection_block)
if(publish_connection_block MATCHES "break_world_snapshot_publication_acquire")
    message(FATAL_ERROR "publication acquire must not enter the per-connection helper")
endif()
if(NOT adapter_source MATCHES "break_world_snapshot_lease_release\\(&lease\\);")
    message(FATAL_ERROR "publish-current drain must release its acquired lease")
endif()

string(REGEX MATCH "add_library\\(runtime_core STATIC[^)]*\\)" runtime_core_block "${cmake_text}")
if(runtime_core_block STREQUAL "")
    message(FATAL_ERROR "missing runtime_core source block")
endif()
if(runtime_core_block MATCHES "runtime_world_session|src/ecs/|src/network/|snow::|Snowflake")
    message(FATAL_ERROR "runtime_core must not own or depend on the World Session bridge")
endif()

string(REGEX MATCH "add_library\\(runtime_world_session STATIC[^)]*\\)" production_block "${cmake_text}")
if(NOT production_block MATCHES "src/runtime/runtime_world_session.c")
    message(FATAL_ERROR "runtime_world_session must own the adapter source")
endif()
if(NOT production_block MATCHES "src/runtime/runtime_world_session_lifecycle.c")
    message(FATAL_ERROR "runtime_world_session must own the lifecycle source")
endif()
string(FIND "${cmake_text}" "add_library(runtime_core STATIC" runtime_core_pos)
string(FIND "${cmake_text}" "add_library(runtime_world_session STATIC" production_pos)
string(FIND "${cmake_text}" "add_library(engine STATIC" engine_pos)
if(production_pos LESS runtime_core_pos OR production_pos GREATER engine_pos)
    message(FATAL_ERROR "production bridge must be a top-level target after runtime_core")
endif()
if(NOT cmake_text MATCHES "target_link_libraries\\(runtime_world_session PUBLIC runtime_core break_net\\)")
    message(FATAL_ERROR "production bridge must link only the production Runtime/network targets")
endif()

string(REGEX MATCH "add_library\\(runtime_world_session_test STATIC EXCLUDE_FROM_ALL[^)]*\\)" test_library_block "${cmake_text}")
if(NOT test_library_block MATCHES "src/runtime/runtime_world_session.c")
    message(FATAL_ERROR "missing separate runtime_world_session_test library")
endif()
if(NOT test_library_block MATCHES "src/runtime/runtime_world_session_lifecycle.c")
    message(FATAL_ERROR "runtime_world_session_test must own the lifecycle source")
endif()
if(NOT cmake_text MATCHES "target_link_libraries\\(runtime_world_session_test PUBLIC[ \t\r\n]+runtime_core_test break_net_test break_ecs_replication_test\\)")
    message(FATAL_ERROR "test bridge must link the test-only Runtime/network variants")
endif()

string(REGEX MATCH "add_executable\\(test_runtime_world_session[^)]*\\)" test_executable_block "${cmake_text}")
if(test_executable_block STREQUAL "")
    message(FATAL_ERROR "missing test_runtime_world_session executable")
endif()
if(NOT test_executable_block MATCHES "tests/test_runtime_world_session.c")
    message(FATAL_ERROR "missing focused test source")
endif()
if(test_executable_block MATCHES "src/runtime/runtime_world_session")
    message(FATAL_ERROR "test executable must not compile bridge sources directly")
endif()
if(NOT cmake_text MATCHES "target_link_libraries\\(test_runtime_world_session PRIVATE[ \t\r\n]+runtime_world_session_test[ \t\r\n]+runtime_core\\)")
    message(FATAL_ERROR "focused test must link the bridge and real Runtime Coordinator")
endif()

message(STATUS "runtime_world_session target contract passed")

# Contract test: rollout config schema + signature self-check.
# -DROLLOUT_JSON=<abs path to engine/assets/rhi_backend_rollout.json>
if(POLICY CMP0054)
    cmake_policy(SET CMP0054 NEW)
endif()
if(POLICY CMP0140)
    cmake_policy(SET CMP0140 NEW)
endif()
if(NOT DEFINED ROLLOUT_JSON)
    message(FATAL_ERROR "ROLLOUT_JSON is required")
endif()
if(NOT EXISTS "${ROLLOUT_JSON}")
    message(FATAL_ERROR "rollout config missing: ${ROLLOUT_JSON}")
endif()
file(READ "${ROLLOUT_JSON}" json)
string(JSON schema ERROR_VARIABLE e GET "${json}" schema_version)
if(NOT "${e}" STREQUAL "NOTFOUND" OR NOT schema EQUAL 1)
    message(FATAL_ERROR "schema_version must be 1")
endif()
string(JSON cfgver GET "${json}" config_version)
if(cfgver LESS 1)
    message(FATAL_ERROR "config_version must be a positive integer")
endif()
string(JSON algo GET "${json}" signature algorithm)
if(NOT algo MATCHES "^(sha256-payload|ed25519-sha256)$")
    message(FATAL_ERROR "signature.algorithm invalid: ${algo}")
endif()
foreach(plat windows linux android macos ios steam-linux proton)
    string(JSON allowed_len ERROR_VARIABLE e2 LENGTH "${json}" platforms ${plat} allowed)
    if(NOT "${e2}" STREQUAL "NOTFOUND" OR allowed_len EQUAL 0)
        message(FATAL_ERROR "platforms.${plat}.allowed missing or empty")
    endif()
    string(JSON chain_len LENGTH "${json}" platforms ${plat} fallback_chain)
    if(chain_len EQUAL 0)
        message(FATAL_ERROR "platforms.${plat}.fallback_chain empty")
    endif()
    # fallback_chain 必须是 allowed 的子序列；且 OHOS 不允许出现。
    math(EXPR cl "${chain_len} - 1")
    foreach(i RANGE ${cl})
        string(JSON b GET "${json}" platforms ${plat} fallback_chain ${i})
        string(JSON allowed_json GET "${json}" platforms ${plat} allowed)
        string(FIND "${allowed_json}" "\"${b}\"" hit)
        if(hit EQUAL -1)
            message(FATAL_ERROR "platforms.${plat}: fallback '${b}' not in allowed")
        endif()
        if(b STREQUAL "ohos")
            message(FATAL_ERROR "platforms.${plat}: OHOS must stay fail-closed, never in a chain")
        endif()
    endforeach()
endforeach()
# OpenGL policy (maintainer decision 2026-10-26): OpenGL is retained
# permanently as the LAST-resort fallback and as the reference backend for
# cross-backend rendering comparison. It is not scheduled for removal.
#  - platforms with a GL backend in this repo: opengl allowed, and it is the
#    final fallback_chain entry (exactly once, behind a primary backend);
#  - platforms without one: opengl must not be advertised.
# Default backend (maintainer decision 2026-10-26): Vulkan is the default on
# Linux and Windows, so the Linux-family chains must start with it. Windows
# keeps its native D3D12 first and Vulkan second; Android is Vulkan-only.
foreach(plat linux steam-linux)
    string(JSON first GET "${json}" platforms ${plat} fallback_chain 0)
    if(NOT first STREQUAL "vulkan")
        message(FATAL_ERROR "platforms.${plat}: vulkan must be the first (default) fallback_chain entry (got '${first}')")
    endif()
endforeach()
string(JSON win_chain GET "${json}" platforms windows fallback_chain)
string(FIND "${win_chain}" "\"vulkan\"" win_vk)
if(win_vk EQUAL -1)
    message(FATAL_ERROR "platforms.windows: vulkan must be in fallback_chain (default backend)")
endif()
set(gl_platforms windows linux steam-linux)
set(non_gl_platforms android macos ios proton)
foreach(plat IN LISTS gl_platforms)
    string(JSON allowed_json GET "${json}" platforms ${plat} allowed)
    string(FIND "${allowed_json}" "\"opengl\"" gl_allowed)
    if(gl_allowed EQUAL -1)
        message(FATAL_ERROR "platforms.${plat}: opengl must stay in allowed (last-resort fallback + comparison reference)")
    endif()
    string(JSON chain_len LENGTH "${json}" platforms ${plat} fallback_chain)
    if(chain_len LESS 2)
        message(FATAL_ERROR "platforms.${plat}: fallback_chain needs a primary backend ahead of opengl")
    endif()
    math(EXPR last "${chain_len} - 1")
    string(JSON tail GET "${json}" platforms ${plat} fallback_chain ${last})
    if(NOT tail STREQUAL "opengl")
        message(FATAL_ERROR "platforms.${plat}: opengl must be the LAST fallback_chain entry (got '${tail}')")
    endif()
    math(EXPR before_last "${last} - 1")
    foreach(i RANGE ${before_last})
        string(JSON b GET "${json}" platforms ${plat} fallback_chain ${i})
        if(b STREQUAL "opengl")
            message(FATAL_ERROR "platforms.${plat}: opengl appears before the end of fallback_chain")
        endif()
    endforeach()
endforeach()
foreach(plat IN LISTS non_gl_platforms)
    string(JSON allowed_json GET "${json}" platforms ${plat} allowed)
    string(FIND "${allowed_json}" "\"opengl\"" gl_allowed)
    if(NOT gl_allowed EQUAL -1)
        message(FATAL_ERROR "platforms.${plat}: no OpenGL backend is built for this platform; do not advertise opengl")
    endif()
endforeach()
message(STATUS "rollout config contract OK (config_version=${cfgver})")

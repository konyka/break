    endif()
    set(sun_first "")
    set(sun_last "")
    if(trace MATCHES "event=render kind=world frame=1 generation=1 [^\n]*sun_y=([-+0-9.eE]+)\n")
        set(sun_first "${CMAKE_MATCH_1}")
    endif()
    if(trace MATCHES "event=render kind=world frame=29 generation=1 [^\n]*sun_y=([-+0-9.eE]+)\n")
        set(sun_last "${CMAKE_MATCH_1}")
    endif()
    if(sun_first STREQUAL "" OR sun_last STREQUAL "")
        record_error("render_record: missing sun_y on frames 1 or 29")
    elseif(NOT sun_first LESS -0.5 OR NOT sun_last GREATER -0.3)
        record_error("render_record: time of day did not advance, sun_y ${sun_first} -> ${sun_last}")
    endif()
    foreach(line IN LISTS world_lines)
        if(NOT line MATCHES "${world_re}")
            record_error("render_record: malformed world line ${line}")
            break()
        endif()
    endforeach()
    foreach(object 0 1)
        if(NOT trace MATCHES "event=resource kind=complete tick=30 slot=${object} request=[0-9]+ generation=1 result=stale\n")
            record_error("render_record: the late generation 1 completion for slot ${object} was not discarded")
        endif()
    endforeach()
    string(FIND "${trace}" "event=level_loaded generation=2" reload_at)
    string(FIND "${trace}" "event=resource kind=complete tick=30 slot=0" stale_at)
    if(reload_at LESS 0 OR stale_at LESS reload_at)
        record_error("render_record: the stale completion did not arrive after the reload")
    endif()
    string(REGEX MATCHALL "event=render kind=skinned [^\n]*\n" skinned_lines "${trace}")
    list(LENGTH skinned_lines skinned_count)
    if(skinned_count LESS 100)
        record_error("render_record: only ${skinned_count} skinned commands")
    endif()
    foreach(line IN LISTS skinned_lines)
        if(NOT line MATCHES "generation=([0-9]+) object=[01] slot=[0-9]+ resource_generation=([0-9]+) version=[0-9]+\n")
            record_error("render_record: malformed skinned line ${line}")
            break()
        endif()
        if(NOT CMAKE_MATCH_1 EQUAL CMAKE_MATCH_2)
            record_error("render_record: skinned resource generation ${CMAKE_MATCH_2} differs from level ${CMAKE_MATCH_1}")
            break()
        endif()
    endforeach()
    if(trace MATCHES "event=render kind=skinned frame=(1|30) ")
        record_error("render_record: a skinned command was issued before its resource was live")
    endif()
    if(NOT trace MATCHES "event=render kind=skinned frame=2 generation=1 object=0 slot=0 resource_generation=1 version=1\n")
        record_error("render_record: the first user skinned command is wrong")
    endif()
    if(NOT trace MATCHES "event=render kind=skinned frame=31 generation=2 object=0 slot=0 resource_generation=2 version=1\n")
        record_error("render_record: the reloaded user resource did not start at version 1 in the reused slot")
    endif()
    set(skin_versions "")
    foreach(frame 35 40 90 95)
        if(trace MATCHES "event=render kind=skinned frame=${frame} generation=2 object=0 slot=0 resource_generation=2 version=([0-9]+)\n")
            list(APPEND skin_versions "${CMAKE_MATCH_1}")
        else()
            record_error("render_record: no user skinned command at frame ${frame}")
        endif()
    endforeach()
    list(LENGTH skin_versions skin_version_count)
    if(skin_version_count EQUAL 4)
        list(GET skin_versions 0 v35)
        list(GET skin_versions 1 v40)
        list(GET skin_versions 2 v90)
        list(GET skin_versions 3 v95)
        if(NOT v40 GREATER v35)
            record_error("render_record: the animated skin version did not advance, ${v35} -> ${v40}")
        endif()
        if(NOT v90 EQUAL v95)
            record_error("render_record: the settled skin version kept changing, ${v90} -> ${v95}")
        endif()
    endif()
    if(NOT trace MATCHES "event=runtime_stopped\n")
        record_error("render_record: run did not stop normally")
    endif()
    else()
        message(FATAL_ERROR "unknown SIM_MODE ${SIM_MODE}")
    endif()
    get_property(errors GLOBAL PROPERTY CORE_APP_LIFECYCLE_ERRORS)
    if(NOT errors STREQUAL "")
        message(FATAL_ERROR "core_app simulation lifecycle failed:\n${errors}")
    endif()
    message(STATUS "core_app simulation lifecycle passed")
    return()
endif()


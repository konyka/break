import struct
import sys
directory, name, mode = sys.argv[1], sys.argv[2], sys.argv[3]
path = directory + "/" + name
with open(path, "rb") as source:
    data = source.read()
if mode == "truncate":
    data = data[:64]
elif mode == "flow":
    data = b"BFLW definitely-not-a-flow-graph\n"

if(POLICY CMP0054)
    cmake_policy(SET CMP0054 NEW)
endif()
if(NOT DEFINED REPO_ROOT)
    message(FATAL_ERROR "REPO_ROOT is required")
endif()
file(READ "${REPO_ROOT}/.github/workflows/ci-image.yml" image)
file(READ "${REPO_ROOT}/.github/workflows/ci.yml" ci)
function(fail text)
    set_property(GLOBAL APPEND PROPERTY CI_IMAGE_CONTRACT_FAILURES "${text}")
endfunction()
function(require_text text needle)
    string(FIND "${text}" "${needle}" offset)
    if(offset EQUAL -1)
        fail("missing: ${needle}")
    endif()
endfunction()
function(require_order text first second)
    string(FIND "${text}" "${first}" a)
    string(FIND "${text}" "${second}" b)
    if(a EQUAL -1 OR b EQUAL -1 OR a GREATER b)
        fail("order required: ${first} -> ${second}")
    endif()
endfunction()

require_order("${image}" "- name: Build candidate image" "- name: Smoke-test the candidate image")
require_order("${image}" "- name: Smoke-test the candidate image" "- name: Login to GHCR")
require_order("${image}" "- name: Login to GHCR" "- name: Publish verified image")
require_text("${image}" "load: true")
require_text("${image}" "push: false")
require_text("${image}" "$IMAGE:candidate-$INPUTS_HASH")
require_text("${image}" "$IMAGE:verified-$INPUTS_HASH")
require_text("${image}" "steps.publish.outputs.digest")
require_text("${image}" "fallback_digest")
require_text("${ci}" "BREAK_CI_LINUX_DIGEST")
require_text("${image}" "force_rebuild")
require_text("${image}" "github.event_name != 'pull_request'")
require_text("${image}" "github.repository == 'konyka/break'")
require_text("${image}" "if: env.PUBLISH == 'true'")
require_text("${image}" "workflow_call:")
require_text("${image}" "digest: \${{ steps.selected.outputs.digest }}")

require_text("${ci}" "uses: ./.github/workflows/ci-image.yml")
require_text("${ci}" "fallback_digest: \${{ vars.BREAK_CI_LINUX_DIGEST }}")
string(FIND "${ci}" "break-ci-linux:latest" latest_offset)
if(NOT latest_offset EQUAL -1)
    fail("ci.yml consumes mutable latest")
endif()
string(REGEX MATCHALL "needs: image" needs_matches "${ci}")
list(LENGTH needs_matches needs_count)
if(NOT needs_count EQUAL 10)
    fail("expected 10 needs:image consumers, got ${needs_count}")
endif()
string(REGEX MATCHALL "image: \\$\\{\\{ needs\\.image\\.outputs\\.digest \\}\\}" digest_matches "${ci}")
list(LENGTH digest_matches digest_count)
if(NOT digest_count EQUAL 10)
    fail("expected 10 immutable digest consumers, got ${digest_count}")
endif()

get_property(failure_lines GLOBAL PROPERTY CI_IMAGE_CONTRACT_FAILURES)
if(failure_lines)
    string(REPLACE ";" "\n" failures "${failure_lines}")
    message(FATAL_ERROR "CI image orchestration contract failed:\n${failures}\n")
endif()
message(STATUS "CI image candidate/publish/digest contract OK")

# Contract test: symbol shape of the multi-backend (runtime fallback) build
# (docs/design/rhi_runtime_backend.md §3).
# -DNM=<nm> -DAPP=<linked app binary> -DAPI_LIST=<dispatch/rhi_backend_api.txt>
# -DMULTI=<ON|OFF>
if(POLICY CMP0054)
    cmake_policy(SET CMP0054 NEW)
endif()
foreach(var NM APP API_LIST MULTI)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "${var} is required")
    endif()
endforeach()
execute_process(COMMAND "${NM}" --defined-only "${APP}"
    OUTPUT_VARIABLE nm_out RESULT_VARIABLE nm_rc)
if(NOT nm_rc EQUAL 0)
    message(FATAL_ERROR "nm failed on ${APP}")
endif()
file(STRINGS "${API_LIST}" api_names REGEX "^rhi_")
string(REPLACE "\n" ";" nm_lines "${nm_out}")
set(defined)
foreach(line IN LISTS nm_lines)
    if(line MATCHES "^[0-9a-fA-F]+ [TtWw] ([A-Za-z0-9_]+)$")
        set(sym "${CMAKE_MATCH_1}")
        if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
            string(REGEX REPLACE "^_" "" sym "${sym}")
        endif()
        list(APPEND defined "${sym}")
    endif()
endforeach()
set(errors "")
foreach(name IN LISTS api_names)
    list(FIND defined "${name}" pub)
    list(FIND defined "rhi_gl_${name}" gl)
    list(FIND defined "rhi_vk_${name}" vk)
    if(pub EQUAL -1)
        string(APPEND errors "public ${name} missing\n")
    endif()
    if(MULTI)
        # Runtime-owned entry: no backend-local copy is compiled.
        if(name STREQUAL "rhi_device_create_compiled")
            if(NOT gl EQUAL -1 OR NOT vk EQUAL -1)
                string(APPEND errors "backend-local ${name} must not exist\n")
            endif()
        elseif(gl EQUAL -1 OR vk EQUAL -1)
            string(APPEND errors "namespaced rhi_gl_/rhi_vk_ ${name} missing\n")
        endif()
    elseif(NOT gl EQUAL -1 OR NOT vk EQUAL -1)
        string(APPEND errors "single-backend build must not contain namespaced ${name}\n")
    endif()
endforeach()
# The runtime module is present exactly when the build is multi-backend.
list(FIND defined "rhi_runtime_active_backend" rt)
if(MULTI AND rt EQUAL -1)
    string(APPEND errors "rhi_runtime_active_backend missing from multi-backend app\n")
elseif(NOT MULTI AND NOT rt EQUAL -1)
    string(APPEND errors "single-backend app must not link the runtime module\n")
endif()
if(NOT errors STREQUAL "")
    message(FATAL_ERROR "multi-backend symbol contract failed for ${APP}:\n${errors}")
endif()
list(LENGTH api_names n)
message(STATUS "multi-backend symbol contract OK (${n} API names, MULTI=${MULTI})")

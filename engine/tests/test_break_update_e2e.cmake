# End-to-end for the online update path:
#   break_manifest_tool (keygen, build, sign)
#     -> break_update_server (TLS, Range)
#     -> break_update_e2e (the real update client over the real break_http transport)
#
# Checked: a good download installs byte-identical files; the rollout gate runs
# before any object is requested; a connection cut mid-chunk resumes from the
# persisted offset instead of byte 0; a chunk tampered on the server is rejected
# by the hash check and installs nothing; a manifest whose signature is wrong is
# rejected before any object request; https without a CA is refused.
#
# -DTOOL -DVERIFY -DSERVER -DCLIENT -DCERT -DKEY -DWORK

foreach(var TOOL VERIFY SERVER CLIENT CERT KEY WORK)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "${var} is required")
    endif()
endforeach()

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

function(run expect_ok)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(expect_ok AND NOT rc EQUAL 0)
        message(FATAL_ERROR "${ARGN} failed (${rc}): ${out}${err}")
    endif()
    if(NOT expect_ok AND rc EQUAL 0)
        message(FATAL_ERROR "${ARGN} unexpectedly succeeded: ${out}")
    endif()
endfunction()

# ---------------------------------------------------------------- the release
set(REL "${WORK}/release")
file(MAKE_DIRECTORY "${REL}/bin")
# a chunk of more than three 64 KiB blocks (so a cut leaves resumable progress)
string(REPEAT "0123456789abcdef" 12500 big)        # 200000 bytes
file(WRITE "${REL}/bin/big.bin" "${big}")
file(WRITE "${REL}/readme.txt" "hello update\n")

run(TRUE "${TOOL}" keygen "${WORK}/rel.priv" "${WORK}/rel.pub")
file(READ "${WORK}/rel.pub" PUB)
string(STRIP "${PUB}" PUB)
run(TRUE "${TOOL}" build "${REL}" 1.2.3 stable linux-x86-64 0.0.0 "${WORK}/body.txt")
run(TRUE "${TOOL}" sign "${WORK}/rel.priv" "${WORK}/body.txt" "${WORK}/manifest")
run(TRUE "${VERIFY}" "${WORK}/manifest" "${PUB}")

file(SHA256 "${REL}/bin/big.bin" BIG_HASH)
file(SHA256 "${REL}/readme.txt" SMALL_HASH)

# serving roots: manifest + objects/<sha256>
function(make_root dir)
    file(REMOVE_RECURSE "${dir}")
    file(MAKE_DIRECTORY "${dir}/objects")
    file(COPY "${WORK}/manifest" DESTINATION "${dir}")
    file(COPY_FILE "${REL}/bin/big.bin" "${dir}/objects/${BIG_HASH}")
    file(COPY_FILE "${REL}/readme.txt" "${dir}/objects/${SMALL_HASH}")
endfunction()

# ------------------------------------------------------------------- servers
# start_server(<tag> <root> <extra server args...>) sets <tag>_PORT / <tag>_LOG
function(start_server tag root)
    set(port_file "${WORK}/${tag}.port")
    set(pid_file "${WORK}/${tag}.pid")
    set(log "${WORK}/${tag}.log")
    file(REMOVE "${port_file}" "${pid_file}" "${log}")
    string(REPLACE ";" "' '" extra "${ARGN}")
    if(extra)
        set(extra "'${extra}'")
    endif()
    execute_process(COMMAND sh -c
        "'${SERVER}' --root '${root}' --cert '${CERT}' --key '${KEY}' --port 0 --print-port --log '${log}' ${extra} > '${port_file}' 2> '${WORK}/${tag}.err' & echo $! > '${pid_file}'"
        RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "could not start the server for ${tag}")
    endif()
    set(port "")
    foreach(i RANGE 100)
        if(EXISTS "${port_file}")
            file(READ "${port_file}" port)
            string(STRIP "${port}" port)
            if(port MATCHES "^[0-9]+$")
                break()
            endif()
        endif()
        execute_process(COMMAND ${CMAKE_COMMAND} -E sleep 0.1)
    endforeach()
    if(NOT port MATCHES "^[0-9]+$")
        file(READ "${WORK}/${tag}.err" err)
        message(FATAL_ERROR "server ${tag} did not print a port: '${port}' ${err}")
    endif()
    set(${tag}_PORT "${port}" PARENT_SCOPE)
    set(${tag}_LOG "${log}" PARENT_SCOPE)
endfunction()

function(stop_server tag)
    if(EXISTS "${WORK}/${tag}.pid")
        file(READ "${WORK}/${tag}.pid" pid)
        string(STRIP "${pid}" pid)
        execute_process(COMMAND sh -c "kill ${pid} 2>/dev/null; wait ${pid} 2>/dev/null; true")
    endif()
endfunction()

# client(<outvar> <rcvar> <root> <port> <ca|-> <step> [args...])
function(client outvar rcvar root port ca step)
    execute_process(COMMAND "${CLIENT}" "${root}" "https://localhost:${port}" "${ca}" "${PUB}" "${step}" ${ARGN}
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    set(${outvar} "${out}${err}" PARENT_SCOPE)
    set(${rcvar} "${rc}" PARENT_SCOPE)
endfunction()

function(count_log_lines log regex outvar)
    set(n 0)
    if(EXISTS "${log}")
        file(STRINGS "${log}" lines)
        foreach(l IN LISTS lines)
            if(l MATCHES "${regex}")
                math(EXPR n "${n}+1")
            endif()
        endforeach()
    endif()
    set(${outvar} ${n} PARENT_SCOPE)
endfunction()

# ============================================================ 1. rollout value
make_root("${WORK}/srv1")
start_server(s1 "${WORK}/srv1" --rollout 2500)
client(out rc "${WORK}/c1" ${s1_PORT} "${CERT}" rollout)
if(NOT rc EQUAL 0 OR NOT out MATCHES "rollout=2500")
    message(FATAL_ERROR "rollout value not read: rc=${rc} ${out}")
endif()

# ===================================================== 2. the happy path
client(out rc "${WORK}/c1" ${s1_PORT} "${CERT}" stage-activate device-1 10000)
if(NOT rc EQUAL 0 OR NOT out MATCHES "stage=ok" OR NOT out MATCHES "slot=A version=1.2.3")
    message(FATAL_ERROR "install failed: rc=${rc} ${out}")
endif()
file(SHA256 "${WORK}/c1/slots/A/files/bin/big.bin" INSTALLED_BIG)
file(SHA256 "${WORK}/c1/slots/A/files/readme.txt" INSTALLED_SMALL)
if(NOT INSTALLED_BIG STREQUAL BIG_HASH OR NOT INSTALLED_SMALL STREQUAL SMALL_HASH)
    message(FATAL_ERROR "installed files differ from the release")
endif()
client(out rc "${WORK}/c1" ${s1_PORT} "${CERT}" status)
if(NOT out MATCHES "slot=A pending=0 version=1.2.3")
    message(FATAL_ERROR "status after install: ${out}")
endif()
stop_server(s1)

# ================================== 3. the rollout gate runs before any object
make_root("${WORK}/srv3")
start_server(s3 "${WORK}/srv3")
client(out rc "${WORK}/c3" ${s3_PORT} "${CERT}" stage device-9 0)
if(rc EQUAL 0 OR NOT out MATCHES "stage=failed error=rollout")
    message(FATAL_ERROR "a device outside the share staged: rc=${rc} ${out}")
endif()
count_log_lines("${s3_LOG}" "^GET /objects/" objects)
count_log_lines("${s3_LOG}" "^GET /manifest" manifests)
if(NOT objects EQUAL 0 OR NOT manifests EQUAL 1)
    message(FATAL_ERROR "rollout gate: objects=${objects} manifests=${manifests} (want 0 and 1)")
endif()
if(EXISTS "${WORK}/c3/slots/A/files")
    file(GLOB_RECURSE leftovers "${WORK}/c3/slots/A/files/*")
    if(leftovers)
        message(FATAL_ERROR "a refused rollout wrote files: ${leftovers}")
    endif()
endif()
stop_server(s3)

# ================================== 4. a cut connection resumes, not restarts
make_root("${WORK}/srv4")
start_server(s4 "${WORK}/srv4" --truncate-request 2)
client(out rc "${WORK}/c4" ${s4_PORT} "${CERT}" stage-activate device-1 10000)
if(rc EQUAL 0 OR NOT out MATCHES "stage=failed error=fetch")
    message(FATAL_ERROR "the cut download did not fail as a fetch error: rc=${rc} ${out}")
endif()
client(out rc "${WORK}/c4" ${s4_PORT} "${CERT}" status)
if(NOT out MATCHES "slot=- pending=0")
    message(FATAL_ERROR "a failed download changed the installed state: ${out}")
endif()
client(out rc "${WORK}/c4" ${s4_PORT} "${CERT}" stage-activate device-1 10000)
if(NOT rc EQUAL 0 OR NOT out MATCHES "slot=A version=1.2.3")
    message(FATAL_ERROR "the resumed install failed: rc=${rc} ${out}")
endif()
file(SHA256 "${WORK}/c4/slots/A/files/bin/big.bin" RESUMED_BIG)
if(NOT RESUMED_BIG STREQUAL BIG_HASH)
    message(FATAL_ERROR "the resumed file differs from the release")
endif()
# the first block was fetched exactly once: the retry continued at 65536
count_log_lines("${s4_LOG}" "bytes=0-65535$" first_block)
count_log_lines("${s4_LOG}" "bytes=65536-131071$" second_block)
if(NOT first_block EQUAL 1)
    message(FATAL_ERROR "the first block was requested ${first_block} times (want exactly 1: resume, not restart)")
endif()
if(NOT second_block EQUAL 2)
    message(FATAL_ERROR "the second block was requested ${second_block} times (want 2: the cut one and the retry)")
endif()
stop_server(s4)

# ============================== 5. a tampered chunk on the server is rejected
make_root("${WORK}/srv5")
file(WRITE "${WORK}/srv5/objects/${SMALL_HASH}" "HELLO UPDATE\n")           # same length, other bytes
start_server(s5 "${WORK}/srv5")
client(out rc "${WORK}/c5" ${s5_PORT} "${CERT}" stage-activate device-1 10000)
if(rc EQUAL 0 OR NOT out MATCHES "stage=failed error=verify")
    message(FATAL_ERROR "a tampered chunk was not rejected by the hash check: rc=${rc} ${out}")
endif()
client(out rc "${WORK}/c5" ${s5_PORT} "${CERT}" status)
if(NOT out MATCHES "slot=- pending=0")
    message(FATAL_ERROR "a tampered download changed the installed state: ${out}")
endif()
stop_server(s5)

# ===================== 6. a manifest with a wrong signature never reaches objects
make_root("${WORK}/srv6")
file(READ "${WORK}/srv6/manifest" mtext)
string(REPLACE "version: 1.2.3" "version: 1.2.4" mtext_bad "${mtext}")
file(WRITE "${WORK}/srv6/manifest" "${mtext_bad}")
start_server(s6 "${WORK}/srv6")
client(out rc "${WORK}/c6" ${s6_PORT} "${CERT}" stage-activate device-1 10000)
if(rc EQUAL 0 OR NOT out MATCHES "stage=failed error=verify")
    message(FATAL_ERROR "a forged manifest was accepted: rc=${rc} ${out}")
endif()
count_log_lines("${s6_LOG}" "^GET /objects/" objects)
if(NOT objects EQUAL 0)
    message(FATAL_ERROR "objects were requested for a manifest that does not verify: ${objects}")
endif()
stop_server(s6)

# ====================================== 7. https without a CA file is refused
make_root("${WORK}/srv7")
start_server(s7 "${WORK}/srv7")
client(out rc "${WORK}/c7" ${s7_PORT} "-" stage device-1 10000)
if(rc EQUAL 0 OR NOT out MATCHES "manifest=fetch-failed")
    message(FATAL_ERROR "the client talked https without a CA file: rc=${rc} ${out}")
endif()
count_log_lines("${s7_LOG}" "^GET " requests)
if(NOT requests EQUAL 0)
    message(FATAL_ERROR "a request reached the server although no CA was given: ${requests}")
endif()
stop_server(s7)

file(REMOVE_RECURSE "${WORK}")
message(STATUS "break_update_e2e OK")

# End-to-end for crash reporting:
#   break_crash_e2e crash   (a real SIGSEGV, captured by break_crash into its spool)
#     -> break_crash_e2e upload (the spool's retry policy over break_http)
#     -> break_crash_server (TLS, symbolize, cluster, count)
#     -> break_crash_report (the operator's view)
#
# Checked: a real crash arrives symbolized (top frame "leaf"); the same defect
# from a second process clusters into one signature; a repeated upload is not
# counted twice; malformed, oversized, mistyped, unknown-build and bad-signal
# bodies are refused with the right status and change nothing; a later build
# crashing after a fix flags a regression; a reply lost in transit leaves the
# record pending and the retry is counted once; a dead server and a missing CA
# leave records pending; an unreadable statistics file answers 500 and is never
# overwritten.
#
# -DSERVER -DREPORT -DCLIENT -DCERT -DKEY -DWORK

foreach(var SERVER REPORT CLIENT CERT KEY WORK)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "${var} is required")
    endif()
endforeach()

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

function(run expect_ok)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(expect_ok AND NOT rc EQUAL 0)
        message(FATAL_ERROR "${ARGN} failed (${rc}): ${out}${err}")
    endif()
    if(NOT expect_ok AND rc EQUAL 0)
        message(FATAL_ERROR "${ARGN} unexpectedly succeeded: ${out}")
    endif()
endfunction()

# client(<outvar> <rcvar> args...)
function(client outvar rcvar)
    execute_process(COMMAND "${CLIENT}" ${ARGN}
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    set(${outvar} "${out}${err}" PARENT_SCOPE)
    set(${rcvar} "${rc}" PARENT_SCOPE)
endfunction()

# report(<outvar> <rcvar> <stats> args...)
function(report outvar rcvar stats)
    execute_process(COMMAND "${REPORT}" "${stats}" ${ARGN}
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    set(${outvar} "${out}${err}" PARENT_SCOPE)
    set(${rcvar} "${rc}" PARENT_SCOPE)
endfunction()

# start_server(<tag> <stats> <extra server args...>) sets <tag>_PORT / <tag>_LOG
function(start_server tag stats)
    set(port_file "${WORK}/${tag}.port")
    set(pid_file "${WORK}/${tag}.pid")
    set(log "${WORK}/${tag}.log")
    file(REMOVE "${port_file}" "${pid_file}" "${log}")
    string(REPLACE ";" "' '" extra "${ARGN}")
    if(extra)
        set(extra "'${extra}'")
    endif()
    execute_process(COMMAND sh -c
        "'${SERVER}' --symbols '${WORK}/symbols' --stats '${stats}' --cert '${CERT}' --key '${KEY}' --port 0 --print-port --log '${log}' ${extra} > '${port_file}' 2> '${WORK}/${tag}.err' & echo $! > '${pid_file}'"
        RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "could not start the server for ${tag}")
    endif()
    set(port "")
    foreach(i RANGE 100)
        if(EXISTS "${port_file}")
            file(READ "${port_file}" port)
            string(STRIP "${port}" port)
            if(port MATCHES "^[0-9]+$")
                break()
            endif()
        endif()
        execute_process(COMMAND ${CMAKE_COMMAND} -E sleep 0.1)
    endforeach()
    if(NOT port MATCHES "^[0-9]+$")
        file(READ "${WORK}/${tag}.err" err)
        message(FATAL_ERROR "server ${tag} did not print a port: '${port}' ${err}")
    endif()
    set(${tag}_PORT "${port}" PARENT_SCOPE)
    set(${tag}_LOG "${log}" PARENT_SCOPE)
endfunction()

function(stop_server tag)
    if(EXISTS "${WORK}/${tag}.pid")
        file(READ "${WORK}/${tag}.pid" pid)
        string(STRIP "${pid}" pid)
        execute_process(COMMAND sh -c "kill ${pid} 2>/dev/null; wait ${pid} 2>/dev/null; true")
    endif()
endfunction()

function(count_log_lines log regex outvar)
    set(n 0)
    if(EXISTS "${log}")
        file(STRINGS "${log}" lines)
        foreach(l IN LISTS lines)
            if(l MATCHES "${regex}")
                math(EXPR n "${n}+1")
            endif()
        endforeach()
    endif()
    set(${outvar} ${n} PARENT_SCOPE)
endfunction()

# post(<outvar> <rcvar> <port> <path> <file> <content-type>)
function(post outvar rcvar port path file ctype)
    client(o r post "https://localhost:${port}${path}" "${CERT}" "${file}" "${ctype}")
    set(${outvar} "${o}" PARENT_SCOPE)
    set(${rcvar} "${r}" PARENT_SCOPE)
endfunction()

set(CT "application/x-break-crash")

# a real crash into a fresh spool; leaves exactly one pending record
function(crash_into spool)
    client(o r crash "${spool}")
    if(r EQUAL 0)
        message(FATAL_ERROR "the crash child exited normally")
    endif()
    client(o r status "${spool}")
    if(NOT o MATCHES "pending=1 sent=0 discarded=0")
        message(FATAL_ERROR "the crash did not leave one pending record: ${o}")
    endif()
endfunction()

# ================================================================ 0. setup
client(BUILD rc build-id)
string(STRIP "${BUILD}" BUILD)
if(NOT BUILD MATCHES "^[0-9a-z-]+$")
    message(FATAL_ERROR "unusable build id '${BUILD}'")
endif()
set(LATER "later-build")
foreach(b "${BUILD}" "${LATER}")
    file(MAKE_DIRECTORY "${WORK}/symbols/${b}")
    file(COPY_FILE "${CLIENT}" "${WORK}/symbols/${b}/break_crash_e2e")
endforeach()
set(STATS "${WORK}/stats.txt")
report(o rc "${STATS}" register-build "${BUILD}")
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "register-build failed: ${o}")
endif()
report(o rc "${STATS}" register-build "${LATER}")
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "register-build failed: ${o}")
endif()

# ============================================ 1. a real crash, symbolized
start_server(s1 "${STATS}")
crash_into("${WORK}/spool1")
client(out rc upload "${WORK}/spool1" "https://localhost:${s1_PORT}" "${CERT}")
if(NOT out MATCHES "uploaded=1" OR NOT out MATCHES "pending=0 sent=1 discarded=0")
    message(FATAL_ERROR "the upload did not complete: ${out}")
endif()
file(STRINGS "${s1_LOG}" lines)
list(LENGTH lines n)
list(GET lines 0 first)
if(NOT n EQUAL 1 OR NOT first MATCHES "^POST /crash 200 sig=[0-9a-f]+ frames=([4-9]|[1-9][0-9]) top=leaf build=${BUILD}$")
    message(FATAL_ERROR "server log for the first crash: '${first}'")
endif()
report(rep1 rc "${STATS}" report)
if(NOT rc EQUAL 0 OR NOT rep1 MATCHES "crash clusters: 1 signatures, 2 builds\n1 ([0-9a-f]+) first=${BUILD} fixed=- top=leaf\n")
    message(FATAL_ERROR "report after the first crash: rc=${rc} ${rep1}")
endif()
string(REGEX MATCH "\n1 ([0-9a-f]+) first" m "${rep1}")
set(SIG16 "${CMAKE_MATCH_1}")
string(LENGTH "${SIG16}" siglen)
if(NOT siglen EQUAL 16)
    message(FATAL_ERROR "no 16-character signature prefix in the report: '${SIG16}'")
endif()

# ============================ 2. the same defect from a second process clusters
crash_into("${WORK}/spool2")
client(out rc upload "${WORK}/spool2" "https://localhost:${s1_PORT}" "${CERT}")
if(NOT out MATCHES "uploaded=1")
    message(FATAL_ERROR "second upload failed: ${out}")
endif()
report(rep2 rc "${STATS}" report)
if(NOT rep2 MATCHES "crash clusters: 1 signatures, 2 builds\n2 ${SIG16} first=${BUILD} fixed=- top=leaf\n")
    message(FATAL_ERROR "the second crash did not join the first cluster: ${rep2}")
endif()

# ======================================= 3. a repeated upload is not counted twice
file(GLOB sent1 "${WORK}/spool1/sent/*.bcr")
list(LENGTH sent1 n)
if(NOT n EQUAL 1)
    message(FATAL_ERROR "expected one sent record, got ${n}")
endif()
list(GET sent1 0 SENT_REC)
post(out rc ${s1_PORT} /crash "${SENT_REC}" "${CT}")
if(NOT rc EQUAL 0 OR NOT out MATCHES "status=200" OR NOT out MATCHES "body=duplicate")
    message(FATAL_ERROR "a repeated record: rc=${rc} ${out}")
endif()
report(rep3 rc "${STATS}" report)
if(NOT rep3 STREQUAL rep2)
    message(FATAL_ERROR "a duplicate changed the statistics:\n${rep2}\n--\n${rep3}")
endif()

# ============================ 4. refused bodies: right status, nothing changes
execute_process(COMMAND sh -c "printf 'not a crash record at all' > '${WORK}/garbage.bin'")
execute_process(COMMAND sh -c "cp '${SENT_REC}' '${WORK}/trailing.bin' && printf '\\n' >> '${WORK}/trailing.bin'")
execute_process(COMMAND sh -c "head -c 100 '${SENT_REC}' > '${WORK}/truncated.bin'")
execute_process(COMMAND sh -c "head -c 70000 /dev/zero | tr '\\000' 'a' > '${WORK}/oversize.bin'")
run(TRUE "${CLIENT}" forge "${WORK}/signal0.bin" "${BUILD}" 0)
run(TRUE "${CLIENT}" forge "${WORK}/signal99.bin" "${BUILD}" 99)
run(TRUE "${CLIENT}" forge "${WORK}/unreg.bin" "unreg-build" 11)
foreach(case
        "garbage.bin|/crash|${CT}|400"
        "trailing.bin|/crash|${CT}|400"
        "truncated.bin|/crash|${CT}|400"
        "oversize.bin|/crash|${CT}|413"
        "signal0.bin|/crash|${CT}|400"
        "signal99.bin|/crash|${CT}|400"
        "unreg.bin|/crash|${CT}|409"
        "garbage.bin|/crash|text/plain|415"
        "garbage.bin|/other|${CT}|404")
    string(REPLACE "|" ";" parts "${case}")
    list(GET parts 0 f)
    list(GET parts 1 p)
    list(GET parts 2 ct)
    list(GET parts 3 want)
    post(out rc ${s1_PORT} "${p}" "${WORK}/${f}" "${ct}")
    if(NOT out MATCHES "status=${want}")
        message(FATAL_ERROR "${f} to ${p} as ${ct}: wanted ${want}, got rc=${rc} ${out}")
    endif()
endforeach()
report(rep4 rc "${STATS}" report)
if(NOT rep4 STREQUAL rep2)
    message(FATAL_ERROR "a refused body changed the statistics:\n${rep2}\n--\n${rep4}")
endif()
# the server is still serving after all of that
post(out rc ${s1_PORT} /crash "${SENT_REC}" "${CT}")
if(NOT out MATCHES "status=200")
    message(FATAL_ERROR "the server stopped answering after the refused bodies: ${out}")
endif()

# ================== 5. a later build crashing after the fix is a regression
report(out rc "${STATS}" mark-fixed "${SIG16}" "${BUILD}")
if(NOT rc EQUAL 0 OR NOT out MATCHES "fixed ${SIG16} at ${BUILD}")
    message(FATAL_ERROR "mark-fixed: rc=${rc} ${out}")
endif()
report(rep5 rc "${STATS}" report)
if(rep5 MATCHES "REGRESSED" OR NOT rep5 MATCHES "fixed=${BUILD}")
    message(FATAL_ERROR "marking fixed should not regress by itself: ${rep5}")
endif()
# the old build keeps crashing after the fix ships: counted, not a regression
run(TRUE "${CLIENT}" rebuild "${SENT_REC}" "${WORK}/old_again.bin" "${BUILD}")
post(out rc ${s1_PORT} /crash "${WORK}/old_again.bin" "${CT}")
if(NOT out MATCHES "body=ok count=3 regression=0")
    message(FATAL_ERROR "an old-build crash after the fix: ${out}")
endif()
# the build released after the fix crashes the same way
run(TRUE "${CLIENT}" rebuild "${SENT_REC}" "${WORK}/later.bin" "${LATER}")
post(out rc ${s1_PORT} /crash "${WORK}/later.bin" "${CT}")
if(NOT out MATCHES "body=ok count=4 regression=1")
    message(FATAL_ERROR "a later-build crash after the fix: ${out}")
endif()
report(rep6 rc "${STATS}" report)
if(NOT rep6 MATCHES "4 ${SIG16} REGRESSED first=${BUILD} fixed=${BUILD} top=leaf")
    message(FATAL_ERROR "the regression is not in the report: ${rep6}")
endif()
report(out rc "${STATS}" mark-fixed "${SIG16}" "${LATER}")
report(rep7 rc "${STATS}" report)
if(rep7 MATCHES "REGRESSED" OR NOT rep7 MATCHES "fixed=${LATER}")
    message(FATAL_ERROR "re-fixing at the later build did not clear the regression: ${rep7}")
endif()
stop_server(s1)

# ============================ 6. report tool refusals
report(out rc "${STATS}" mark-fixed "ffffffff" "${BUILD}")
if(rc EQUAL 0)
    message(FATAL_ERROR "mark-fixed accepted an unknown signature: ${out}")
endif()
report(out rc "${STATS}" mark-fixed "${SIG16}" "no-such-build")
if(rc EQUAL 0)
    message(FATAL_ERROR "mark-fixed accepted an unregistered build: ${out}")
endif()
report(out rc "${STATS}" mark-fixed "${SIG16}" "${BUILD}" extra)
if(rc EQUAL 0)
    message(FATAL_ERROR "extra arguments were accepted")
endif()
report(out rc "${STATS}" register-build "${BUILD}")
if(rc EQUAL 0)
    message(FATAL_ERROR "register-build accepted a duplicate")
endif()
report(out rc "${STATS}" register-build "Bad Id")
if(rc EQUAL 0)
    message(FATAL_ERROR "register-build accepted a malformed id")
endif()
report(rep8 rc "${STATS}" report)
if(NOT rep8 STREQUAL rep7)
    message(FATAL_ERROR "a refused command changed the statistics")
endif()
report(out rc "${WORK}/never-written.txt" report)
if(NOT rc EQUAL 0 OR NOT out MATCHES "crash clusters: 0 signatures, 0 builds")
    message(FATAL_ERROR "a missing statistics file should read as empty: rc=${rc} ${out}")
endif()

# ======================== 7. a reply lost in transit: retried, counted once
set(STATS2 "${WORK}/stats2.txt")
report(out rc "${STATS2}" register-build "${BUILD}")
start_server(s7 "${STATS2}" --drop-response 1)
crash_into("${WORK}/spool7")
client(out rc upload "${WORK}/spool7" "https://localhost:${s7_PORT}" "${CERT}")
if(NOT out MATCHES "uploaded=0" OR NOT out MATCHES "pending=1 sent=0 discarded=0")
    message(FATAL_ERROR "a lost reply should leave the record pending: ${out}")
endif()
report(out rc "${STATS2}" report)
if(NOT out MATCHES "crash clusters: 1 signatures, 1 builds\n1 ")
    message(FATAL_ERROR "the dropped-reply request should still have been counted once: ${out}")
endif()
client(out rc upload "${WORK}/spool7" "https://localhost:${s7_PORT}" "${CERT}")
if(NOT out MATCHES "uploaded=1" OR NOT out MATCHES "pending=0 sent=1 discarded=0")
    message(FATAL_ERROR "the retry did not complete: ${out}")
endif()
report(out rc "${STATS2}" report)
if(NOT out MATCHES "crash clusters: 1 signatures, 1 builds\n1 ")
    message(FATAL_ERROR "the retry was counted a second time: ${out}")
endif()

# ================================================ 8. a dead server, then a live one
set(DEAD_PORT ${s7_PORT})
stop_server(s7)
crash_into("${WORK}/spool8")
client(out rc upload "${WORK}/spool8" "https://localhost:${DEAD_PORT}" "${CERT}")
if(NOT out MATCHES "uploaded=0" OR NOT out MATCHES "pending=1 sent=0 discarded=0")
    message(FATAL_ERROR "a dead server should leave the record pending: ${out}")
endif()
start_server(s8 "${STATS2}")
# no CA file: https is refused before any connection is made
client(out rc upload "${WORK}/spool8" "https://localhost:${s8_PORT}" "-")
if(NOT out MATCHES "uploaded=0" OR NOT out MATCHES "pending=1 sent=0 discarded=0")
    message(FATAL_ERROR "an upload without a CA file should fail: ${out}")
endif()
count_log_lines("${s8_LOG}" "^POST " requests)
if(NOT requests EQUAL 0)
    message(FATAL_ERROR "a request reached the server although no CA was given: ${requests}")
endif()
client(out rc upload "${WORK}/spool8" "https://localhost:${s8_PORT}" "${CERT}")
if(NOT out MATCHES "uploaded=1" OR NOT out MATCHES "pending=0 sent=1 discarded=0")
    message(FATAL_ERROR "the record was not delivered once the server was up: ${out}")
endif()
report(out rc "${STATS2}" report)
if(NOT out MATCHES "crash clusters: 1 signatures, 1 builds\n2 ")
    message(FATAL_ERROR "the second process did not join the cluster: ${out}")
endif()
stop_server(s8)

# ====================== 9. an unreadable statistics file: 500, never overwritten
set(STATS3 "${WORK}/stats3.txt")
file(WRITE "${STATS3}" "this is not a statistics file\n")
start_server(s9 "${STATS3}")
post(out rc ${s9_PORT} /crash "${SENT_REC}" "${CT}")
if(NOT out MATCHES "status=500")
    message(FATAL_ERROR "a corrupt statistics file should answer 500: ${out}")
endif()
post(out rc ${s9_PORT} /crash "${SENT_REC}" "${CT}")
if(NOT out MATCHES "status=500")
    message(FATAL_ERROR "the server did not survive a corrupt statistics file: ${out}")
endif()
file(READ "${STATS3}" kept)
if(NOT kept STREQUAL "this is not a statistics file\n")
    message(FATAL_ERROR "the corrupt statistics file was overwritten: ${kept}")
endif()
report(out rc "${STATS3}" report)
if(rc EQUAL 0)
    message(FATAL_ERROR "report accepted a corrupt statistics file")
endif()
report(out rc "${STATS3}" register-build "${BUILD}")
if(rc EQUAL 0)
    message(FATAL_ERROR "register-build overwrote a corrupt statistics file")
endif()
file(READ "${STATS3}" kept)
if(NOT kept STREQUAL "this is not a statistics file\n")
    message(FATAL_ERROR "the corrupt statistics file was changed by the report tool")
endif()
stop_server(s9)

# ====== 10. a refusal keeps the record pending until its attempts run out
set(STATS4 "${WORK}/stats4.txt")
report(out rc "${STATS4}" register-build "${BUILD}")
start_server(s10 "${STATS4}")
run(TRUE "${CLIENT}" spool-put "${WORK}/spool10" "${WORK}/unreg.bin")        # build id the server does not know
client(out rc status "${WORK}/spool10")
if(NOT out MATCHES "pending=1 sent=0 discarded=0")
    message(FATAL_ERROR "spool-put: ${out}")
endif()
foreach(pass RANGE 1 4)
    client(out rc upload "${WORK}/spool10" "https://localhost:${s10_PORT}" "${CERT}")
    if(NOT out MATCHES "uploaded=0" OR NOT out MATCHES "pending=1 sent=0 discarded=0")
        message(FATAL_ERROR "a refused record (pass ${pass}) must stay pending: ${out}")
    endif()
endforeach()
client(out rc upload "${WORK}/spool10" "https://localhost:${s10_PORT}" "${CERT}")
if(NOT out MATCHES "uploaded=0" OR NOT out MATCHES "pending=0 sent=0 discarded=1")
    message(FATAL_ERROR "after 5 refused attempts the record must be discarded: ${out}")
endif()
count_log_lines("${s10_LOG}" "^POST /crash 409" refusals)
if(NOT refusals EQUAL 5)
    message(FATAL_ERROR "expected exactly 5 attempts, saw ${refusals}")
endif()
report(out rc "${STATS4}" report)
if(NOT out MATCHES "crash clusters: 0 signatures, 1 builds")
    message(FATAL_ERROR "a refused record changed the statistics: ${out}")
endif()
stop_server(s10)

# ===== 11. a statistics file that cannot be rewritten answers 500, not 200
execute_process(COMMAND id -u OUTPUT_VARIABLE uid OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT uid STREQUAL "0")
    set(RO "${WORK}/ro")
    file(MAKE_DIRECTORY "${RO}")
    set(STATS5 "${RO}/stats.txt")
    report(out rc "${STATS5}" register-build "${BUILD}")                     # creates the file and its lock
    file(READ "${STATS5}" before)
    start_server(s11 "${STATS5}")
    execute_process(COMMAND chmod 555 "${RO}")
    post(out rc ${s11_PORT} /crash "${SENT_REC}" "${CT}")
    execute_process(COMMAND chmod 755 "${RO}")
    if(NOT out MATCHES "status=500")
        message(FATAL_ERROR "an unwritable statistics file should answer 500: ${out}")
    endif()
    file(READ "${STATS5}" after)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "a failed save changed the statistics file")
    endif()
    # the record was NOT remembered as counted: once the file is writable it counts
    post(out rc ${s11_PORT} /crash "${SENT_REC}" "${CT}")
    if(NOT out MATCHES "status=200" OR NOT out MATCHES "body=ok count=1")
        message(FATAL_ERROR "the retry after the save failure: ${out}")
    endif()
    stop_server(s11)
else()
    message(STATUS "running as root: skipping the unwritable-file case")
endif()

file(REMOVE_RECURSE "${WORK}")
message(STATUS "break_crash_e2e OK")

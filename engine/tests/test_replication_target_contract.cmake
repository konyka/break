if(NOT DEFINED ENGINE_CMAKE)
    message(FATAL_ERROR "ENGINE_CMAKE is required")
endif()

file(READ "${ENGINE_CMAKE}" cmake_text)
foreach(target IN ITEMS break_ecs_replication break_replication_core)
    if(NOT cmake_text MATCHES "add_library\\(${target} STATIC")
        message(FATAL_ERROR "missing formal target ${target}")
    endif()
endforeach()

string(FIND "${cmake_text}" "add_library(break_ecs_replication STATIC" ecs_target_pos)
string(FIND "${cmake_text}" "add_library(break_replication_core STATIC" core_target_pos)
foreach(source IN ITEMS replication_schema.c world_snapshot.c world_delta.c)
    string(FIND "${cmake_text}" "src/ecs/${source}" source_pos)
    if(source_pos LESS ecs_target_pos OR source_pos GREATER core_target_pos)
        message(FATAL_ERROR "${source} is not owned by break_ecs_replication")
    endif()
endforeach()

foreach(source IN ITEMS break_aoi.c break_replication.c break_replication_fragment.c)
    string(FIND "${cmake_text}" "src/network/${source}" source_pos)
    if(source_pos LESS core_target_pos)
        message(FATAL_ERROR "${source} is not owned by break_replication_core")
    endif()
endforeach()

string(FIND "${cmake_text}" "target_compile_definitions(break_ecs_replication PRIVATE BREAK_WORLD_DELTA_TESTING" leaked_pos)
if(NOT leaked_pos EQUAL -1)
    message(FATAL_ERROR "test-only fault injection leaked into break_ecs_replication")
endif()
if(cmake_text MATCHES "add_executable\\(test_ecs_replication[^\\)]*src/ecs/(replication_schema|world_snapshot|world_delta)\\.c")
    message(FATAL_ERROR "test_ecs_replication still owns ECS replication sources")
endif()
if(cmake_text MATCHES "add_library\\(break_replication_fragment STATIC")
    message(FATAL_ERROR "legacy fragment-only target remains")
endif()
message(STATUS "formal replication target contract passed")

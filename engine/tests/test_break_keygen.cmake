# End-to-end: tools/break_keygen provisions per-device keys for
# `editor --remote-keyring-file`.
#   break_keygen <keyring> <16-hex key id> <device psk out>
# appends "<id> <64 hex psk>" to the keyring (created mode 0600 if missing),
# writes the same 32 raw PSK bytes to the device file (mode 0600, must not
# exist), refuses duplicate ids and invalid ids, and never touches either
# file on failure.
# -DKEYGEN=<break_keygen> -DWORK=<scratch dir>
if(NOT DEFINED KEYGEN OR NOT DEFINED WORK)
    message(FATAL_ERROR "KEYGEN and WORK are required")
endif()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(RING "${WORK}/ring.txt")

function(keygen expect_ok)
    execute_process(COMMAND "${KEYGEN}" ${ARGN}
                    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(expect_ok AND NOT rc EQUAL 0)
        message(FATAL_ERROR "break_keygen ${ARGN} failed (${rc}): ${out}${err}")
    endif()
    if(NOT expect_ok AND rc EQUAL 0)
        message(FATAL_ERROR "break_keygen ${ARGN} unexpectedly succeeded")
    endif()
endfunction()

keygen(TRUE "${RING}" 6465766963653031 "${WORK}/dev1.psk")
keygen(TRUE "${RING}" 6465766963653032 "${WORK}/dev2.psk")
file(STRINGS "${RING}" lines)
list(LENGTH lines n)
if(NOT n EQUAL 2)
    message(FATAL_ERROR "keyring should hold 2 lines, got ${n}: ${lines}")
endif()
list(GET lines 0 l0)
list(GET lines 1 l1)
if(NOT l0 MATCHES "^6465766963653031 [0-9a-f]+$" OR NOT l1 MATCHES "^6465766963653032 [0-9a-f]+$")
    message(FATAL_ERROR "unexpected keyring lines: ${lines}")
endif()
string(LENGTH "${l0}" len0)
if(NOT len0 EQUAL 81)
    message(FATAL_ERROR "keyring line must be 16+1+64 chars: ${l0}")
endif()
# the device file is the same secret as raw bytes
file(READ "${WORK}/dev1.psk" raw HEX)
string(LENGTH "${raw}" rawlen)
if(NOT rawlen EQUAL 64)
    message(FATAL_ERROR "device psk must be 32 bytes, got hex ${raw}")
endif()
string(SUBSTRING "${l0}" 17 64 hex0)
if(NOT raw STREQUAL hex0)
    message(FATAL_ERROR "device psk ${raw} does not match keyring ${hex0}")
endif()
# two keys are different
string(SUBSTRING "${l1}" 17 64 hex1)
if(hex0 STREQUAL hex1)
    message(FATAL_ERROR "two generated keys are identical")
endif()
if(UNIX)
    # `ls -l` is portable across GNU and BSD (stat -c is GNU-only)
    execute_process(COMMAND ls -l "${RING}" OUTPUT_VARIABLE m1 OUTPUT_STRIP_TRAILING_WHITESPACE)
    execute_process(COMMAND ls -l "${WORK}/dev1.psk" OUTPUT_VARIABLE m2 OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT m1 MATCHES "^-rw-------" OR NOT m2 MATCHES "^-rw-------")
        message(FATAL_ERROR "files must be mode 600: ring ${m1}, psk ${m2}")
    endif()
endif()

file(READ "${RING}" before)
# duplicate id, bad id, existing device file, missing args: all fail and
# leave the keyring untouched
keygen(FALSE "${RING}" 6465766963653031 "${WORK}/dev3.psk")
if(EXISTS "${WORK}/dev3.psk")
    message(FATAL_ERROR "failed run left a device file behind")
endif()
keygen(FALSE "${RING}" 64657669636530 "${WORK}/dev4.psk")
keygen(FALSE "${RING}" zz65766963653033 "${WORK}/dev5.psk")
keygen(FALSE "${RING}" 6465766963653033 "${WORK}/dev1.psk")
keygen(FALSE "${RING}")
file(READ "${RING}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "a failed run modified the keyring")
endif()
# a full ring (8 keys) refuses a ninth
foreach(i 3 4 5 6 7 8)
    keygen(TRUE "${RING}" 646576696365300${i} "${WORK}/d${i}.psk")
endforeach()
keygen(FALSE "${RING}" 6465766963653039 "${WORK}/d9.psk")

# a hand-edited keyring whose last line has no trailing LF must not merge
# with the appended key
set(RING2 "${WORK}/ring2.txt")
file(WRITE "${RING2}" "6465766963653031 00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff")
if(UNIX)
    execute_process(COMMAND chmod 600 "${RING2}")
endif()
keygen(TRUE "${RING2}" 6465766963653032 "${WORK}/n2.psk")
file(STRINGS "${RING2}" lines2)
list(LENGTH lines2 n2)
if(NOT n2 EQUAL 2)
    message(FATAL_ERROR "append after a missing trailing LF merged lines: ${lines2}")
endif()

if(UNIX)
    # --- ring hardening (independent review 2026-10-30) ---
    function(write_ring path nbytes)
        # one comment line of exactly nbytes bytes including the final LF
        math(EXPR fill "${nbytes} - 2")
        string(REPEAT "x" ${fill} body)
        file(WRITE "${path}" "#${body}\n")
        execute_process(COMMAND chmod 600 "${path}")
    endfunction()
    function(file_size out path)
        file(SIZE "${path}" sz)
        set(${out} ${sz} PARENT_SCOPE)
    endfunction()

    # the editor refuses a keyring above 2047 bytes, so keygen must not grow
    # one past that: 1990 + 82 = 2072 is refused and changes nothing
    set(RING3 "${WORK}/ring3.txt")
    write_ring("${RING3}" 1990)
    file(READ "${RING3}" r3_before)
    keygen(FALSE "${RING3}" 6465766963653031 "${WORK}/c1.psk")
    file(READ "${RING3}" r3_after)
    if(NOT r3_before STREQUAL r3_after OR EXISTS "${WORK}/c1.psk")
        message(FATAL_ERROR "an over-cap append changed the ring or left a device file")
    endif()
    # exactly at the cap is still fine: 1965 + 82 = 2047
    set(RING4 "${WORK}/ring4.txt")
    write_ring("${RING4}" 1965)
    keygen(TRUE "${RING4}" 6465766963653031 "${WORK}/c2.psk")
    file_size(r4_size "${RING4}")
    if(NOT r4_size EQUAL 2047)
        message(FATAL_ERROR "ring at the cap should be 2047 bytes, got ${r4_size}")
    endif()

    # a symlinked keyring is not followed
    set(REAL "${WORK}/real_ring.txt")
    file(WRITE "${REAL}" "# real\n")
    execute_process(COMMAND chmod 600 "${REAL}")
    execute_process(COMMAND ln -s "${REAL}" "${WORK}/ring.link")
    keygen(FALSE "${WORK}/ring.link" 6465766963653031 "${WORK}/l1.psk")
    file(READ "${REAL}" real_after)
    if(NOT real_after STREQUAL "# real\n" OR EXISTS "${WORK}/l1.psk")
        message(FATAL_ERROR "keygen followed a keyring symlink")
    endif()

    # a keyring readable by group/other is refused (it holds secrets)
    set(RING5 "${WORK}/ring5.txt")
    file(WRITE "${RING5}" "# open\n")
    execute_process(COMMAND chmod 644 "${RING5}")
    keygen(FALSE "${RING5}" 6465766963653031 "${WORK}/m1.psk")
    file(READ "${RING5}" r5_after)
    if(NOT r5_after STREQUAL "# open\n" OR EXISTS "${WORK}/m1.psk")
        message(FATAL_ERROR "keygen appended to a group/other-readable keyring")
    endif()

    # a missing keyring that cannot be completed is not left behind
    # (device file path already exists -> failure after the ring was created)
    file(WRITE "${WORK}/exists.psk" "x")
    keygen(FALSE "${WORK}/ring6.txt" 6465766963653031 "${WORK}/exists.psk")
    if(EXISTS "${WORK}/ring6.txt")
        message(FATAL_ERROR "a failed first run left an empty keyring behind")
    endif()

    # a short write (file size limit, SIGXFSZ ignored) must leave the ring
    # byte-identical and no device file behind
    set(RING7 "${WORK}/ring7.txt")
    write_ring("${RING7}" 500)
    file(READ "${RING7}" r7_before)
    execute_process(COMMAND sh -c "trap '' XFSZ; ulimit -f 1; exec '${KEYGEN}' '${RING7}' 6465766963653031 '${WORK}/f1.psk'"
                    RESULT_VARIABLE rc7 OUTPUT_QUIET ERROR_QUIET)
    if(rc7 EQUAL 0)
        message(FATAL_ERROR "append beyond the file size limit unexpectedly succeeded")
    endif()
    file(READ "${RING7}" r7_after)
    if(NOT r7_before STREQUAL r7_after)
        message(FATAL_ERROR "a short write left a torn keyring")
    endif()
    if(EXISTS "${WORK}/f1.psk")
        message(FATAL_ERROR "a failed append left its device file behind")
    endif()

    # concurrent runs never exceed the ring size or tear a line
    set(RING8 "${WORK}/ring8.txt")
    execute_process(COMMAND sh -c
        "i=0; while [ $i -lt 12 ]; do id=$(printf '64657669636530%02x' $i); '${KEYGEN}' '${RING8}' $id '${WORK}/p'$i'.psk' >/dev/null 2>&1 & i=$((i+1)); done; wait"
        RESULT_VARIABLE rc8)
    file(STRINGS "${RING8}" lines8)
    list(LENGTH lines8 n8)
    if(NOT n8 EQUAL 8)
        message(FATAL_ERROR "12 parallel runs should leave exactly 8 keys, got ${n8}")
    endif()
    foreach(l ${lines8})
        string(LENGTH "${l}" ll)
        if(NOT ll EQUAL 81 OR NOT l MATCHES "^[0-9a-f]+ [0-9a-f]+$")
            message(FATAL_ERROR "torn or malformed keyring line under concurrency: ${l}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES lines8)
    list(LENGTH lines8 n8u)
    if(NOT n8u EQUAL 8)
        message(FATAL_ERROR "duplicate lines under concurrency")
    endif()
    file(GLOB psks "${WORK}/p*.psk")
    list(LENGTH psks npsk)
    if(NOT npsk EQUAL 8)
        message(FATAL_ERROR "failed parallel runs must not leave device files: ${npsk}")
    endif()
endif()
file(REMOVE_RECURSE "${WORK}")
message(STATUS "break_keygen OK")

foreach(required IN ITEMS CORE_APP_PROCESS_LAUNCH CORE_APP_ASSET_BAKE WORK)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
foreach(path IN ITEMS CORE_APP_PROCESS_LAUNCH CORE_APP_ASSET_BAKE)
    if(NOT EXISTS "${${path}}")
        message(FATAL_ERROR "${path} does not exist: ${${path}}")
    endif()
endforeach()
foreach(path IN ITEMS CORE_APP_ASSET_BAKE WORK)
    string(FIND "${${path}}" " " space_offset)
    if(NOT space_offset EQUAL -1)
        message(FATAL_ERROR
            "The unquoted process launch variant requires paths without spaces: ${${path}}")
    endif()
endforeach()

set(original "\"${CORE_APP_ASSET_BAKE}\" --output \"${WORK}/original\"")
set(outer_quoted "\"${original}\"")
string(REPLACE "${WORK}/original" "${WORK}/outer_quoted" outer_quoted "${outer_quoted}")
set(exe_backslashes "${CORE_APP_ASSET_BAKE}")
set(out_backslashes "${WORK}/backslashes")
string(REPLACE "/" "\\" exe_backslashes "${exe_backslashes}")
string(REPLACE "/" "\\" out_backslashes "${out_backslashes}")
set(backslashes "\"${exe_backslashes}\" --output \"${out_backslashes}\"")
set(unquoted "${CORE_APP_ASSET_BAKE} --output ${WORK}/unquoted")

foreach(variant IN ITEMS original outer_quoted backslashes unquoted)
    set(command "${${variant}}")
    execute_process(COMMAND "${CORE_APP_PROCESS_LAUNCH}" "${command}"
        RESULT_VARIABLE result
        OUTPUT_VARIABLE stdout
        ERROR_VARIABLE stderr)
    if(EXISTS "${WORK}/${variant}/level.bscn")
        set(level_bscn YES)
    else()
        set(level_bscn NO)
    endif()
    set(${variant}_result "${result}")
    set(${variant}_level_bscn "${level_bscn}")
    set(${variant}_stdout "${stdout}")
    file(WRITE "${WORK}/${variant}.command.log" "${command}\n")
    file(WRITE "${WORK}/${variant}.stdout.log" "${stdout}")
    file(WRITE "${WORK}/${variant}.stderr.log" "${stderr}")
    message(STATUS
        "CORE_APP_PROCESS_LAUNCH_VARIANT variant=${variant} result=${result} level_bscn=${level_bscn}\ncommand=${command}\n--- stdout ---\n${stdout}\n--- stderr ---\n${stderr}\n--- end ${variant} ---")
endforeach()

if(WIN32)
    if(NOT "${original_result}" STREQUAL "1")
        message(FATAL_ERROR
            "Windows original helper result must be exactly 1 after system(); got '${original_result}'; no repair conclusion")
    endif()
    string(REGEX MATCH "CORE_APP_PROCESS_LAUNCH command=.* raw=(-?[0-9]+) os_error=[0-9]+ errno=-?[0-9]+" original_record "${original_stdout}")
    if("${original_record}" STREQUAL "")
        message(FATAL_ERROR
            "Windows original helper stdout lacks a CORE_APP_PROCESS_LAUNCH record with numeric raw/os_error/errno; no repair conclusion")
    endif()
    set(original_raw "${CMAKE_MATCH_1}")
    if(original_raw EQUAL 0)
        message(FATAL_ERROR
            "Windows original raw system() result must be numeric nonzero; got '${original_raw}'; no repair conclusion")
    endif()
    set(candidate_success NO)
    foreach(candidate IN ITEMS outer_quoted backslashes unquoted)
        if("${${candidate}_result}" STREQUAL "0" AND ${candidate}_level_bscn)
            set(candidate_success YES)
        endif()
    endforeach()
    if(NOT candidate_success)
        message(FATAL_ERROR
            "Windows process launch candidates all failed or produced no level.bscn; no repair conclusion")
    endif()
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    if(NOT "${original_result}" STREQUAL "0" OR NOT original_level_bscn)
        message(FATAL_ERROR
            "Linux original process launch failed or produced no level.bscn; helper boundary is invalid")
    endif()
endif()

message(STATUS "Core App process launch probe completed")

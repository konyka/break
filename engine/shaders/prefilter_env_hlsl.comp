// prefilter_env_hlsl.comp - D3D12 sidecar of shaders/prefilter_env.comp
// (the GL variant). GGX importance-sampled pre-integration of the
// environment cube into one (face, mip) of the prefiltered cube; roughness
// comes from the mip. u0 = the output face/mip (single-slice TEXTURE2DARRAY
// UAV), t1 = the environment cube, sampled LINEAR at mip 0 (the env cube
// has one mip, as in the GLSL texture() call).
struct PushConsts {
    float u_roughness;   //  0
    int   u_face;        //  4
    int   u_mip_size;    //  8
};                       // tail at 12
ConstantBuffer<PushConsts> g_push : register(b0, space0);
// rhi:uniform u_roughness 0
// rhi:uniform u_face 4
// rhi:uniform u_mip_size 8
RWTexture2DArray<float4> g_out_face : register(u0);
TextureCube              g_env_map  : register(t1);
SamplerState             g_smp      : register(s1);

static const float PI = 3.14159265359;

float radical_inverse_vdc(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}
float2 hammersley(uint i, uint n) {
    return float2(float(i) / float(n), radical_inverse_vdc(i));
}
float3 importance_sample_ggx(float2 xi, float3 N, float roughness) {
    float a = roughness * roughness;
    float phi = 2.0 * PI * xi.x;
    float cos_theta = sqrt((1.0 - xi.y) / (1.0 + (a * a - 1.0) * xi.y));
    float sin_theta = sqrt(1.0 - cos_theta * cos_theta);
    float3 H = float3(cos(phi) * sin_theta, sin(phi) * sin_theta, cos_theta);
    float3 up = abs(N.z) < 0.999 ? float3(0.0, 0.0, 1.0) : float3(1.0, 0.0, 0.0);
    float3 tangent = normalize(cross(up, N));
    float3 bitangent = cross(N, tangent);
    return normalize(tangent * H.x + bitangent * H.y + N * H.z);
}
float3 cube_dir_from_face_uv(int face, float2 uv) {
    float2 t = uv * 2.0 - 1.0;
    float3 d;
    if      (face == 0) d = float3( 1.0, -t.y, -t.x);
    else if (face == 1) d = float3(-1.0, -t.y,  t.x);
    else if (face == 2) d = float3( t.x,  1.0,  t.y);
    else if (face == 3) d = float3( t.x, -1.0, -t.y);
    else if (face == 4) d = float3( t.x, -t.y,  1.0);
    else                d = float3(-t.x, -t.y, -1.0);
    return normalize(d);
}

[numthreads(16, 16, 1)]
void main(uint3 id : SV_DispatchThreadID) {
    int2 px = int2(id.xy);
    if (px.x >= g_push.u_mip_size || px.y >= g_push.u_mip_size) return;
    float2 uv = (float2(px) + 0.5) / float(g_push.u_mip_size);
    float3 N = cube_dir_from_face_uv(g_push.u_face, uv);
    float3 V = N;
    uint sample_count = (uint)lerp(64.0, 1024.0, g_push.u_roughness);
    float3 color = 0.0;
    float total_weight = 0.0;
    for (uint i = 0u; i < sample_count; ++i) {
        float3 H = importance_sample_ggx(hammersley(i, sample_count), N,
                                         g_push.u_roughness);
        float3 L = normalize(2.0 * dot(V, H) * H - V);
        float n_dot_l = max(dot(N, L), 0.0);
        if (n_dot_l > 0.0) {
            color += g_env_map.SampleLevel(g_smp, L, 0.0).rgb * n_dot_l;
            total_weight += n_dot_l;
        }
    }
    color /= max(total_weight, 1e-5);
    g_out_face[uint3(px, 0)] = float4(color, 1.0);
}

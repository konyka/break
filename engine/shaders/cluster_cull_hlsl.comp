// cluster_cull_hlsl.comp - D3D12 sidecar of shaders/cluster_cull.comp (the
// GL variant). GPU clustered light binning: one thread per cluster
// (16 x 8 x 24) tests every point light against the cluster's screen tile
// and view-depth slice and writes the surviving indices into a fixed
// per-cluster region of the grid, in the same dense uint layout the CPU
// producer (light_system_cull) and the lighting shaders use.
//
// Light data is the per-frame host-written buffer (UPLOAD heap), which can
// only be an SRV -- GLSL's `readonly buffer` at binding 0 becomes t0, the
// sidecar convention compact_draws_hlsl.comp follows. The grid is a
// DEFAULT-heap buffer created with zeroed data, written as a raw UAV at u1.
struct PushConsts {
    float4x4 u_cc_vp;       //  0
    float4   u_cc_params0;  // 64  x point_count, y screen_w, z screen_h, w near
    float4   u_cc_params1;  // 80  x far
};                          // tail at 96
ConstantBuffer<PushConsts> g_push : register(b0, space0);
// rhi:uniform u_cc_vp 0
// rhi:uniform u_cc_params0 64
// rhi:uniform u_cc_params1 80
ByteAddressBuffer   g_light_data : register(t0);
RWByteAddressBuffer g_grid       : register(u1);

static const uint CX = 16u;
static const uint CY = 8u;
static const uint CZ = 24u;
static const uint CLUSTER_COUNT = CX * CY * CZ;
static const uint MAX_PER = 128u;

float cluster_depth(uint z) {
    float nearp = g_push.u_cc_params0.w;
    float farp = g_push.u_cc_params1.x;
    return nearp * exp2(log2(farp / nearp) * float(z) / float(CZ));
}

[numthreads(64, 1, 1)]
void main(uint3 id : SV_DispatchThreadID) {
    uint ci = id.x;
    if (ci >= CLUSTER_COUNT) return;
    uint cx = ci % CX;
    uint cy = (ci / CX) % CY;
    uint cz = ci / (CX * CY);
    float screen_w = g_push.u_cc_params0.y;
    float screen_h = g_push.u_cc_params0.z;
    float z_near = cluster_depth(cz);
    float z_far = cluster_depth(cz + 1u);
    float tile_w = screen_w / float(CX);
    float tile_h = screen_h / float(CY);
    float sx = float(cx) * tile_w;
    float ex = float(cx + 1u) * tile_w;
    float sy = float(cy) * tile_h;
    float ey = float(cy + 1u) * tile_h;
    uint gb = CLUSTER_COUNT * 2u;
    uint offset = ci * MAX_PER;
    uint count = 0u;
    uint n = (uint)g_push.u_cc_params0.x;
    for (uint li = 0u; li < n && count < MAX_PER; ++li) {
        uint b = li * 32u;
        float4 pr = asfloat(g_light_data.Load4(b));
        float3 p = pr.xyz;
        float r = pr.w;
        float4 clip = mul(g_push.u_cc_vp, float4(p, 1.0));
        float view_z = -clip.w;
        if (view_z + r < -z_far || view_z - r > -z_near) continue;
        if (clip.w > 0.001) {
            float inv_w = 1.0 / clip.w;
            float sx2 = (clip.x * inv_w * 0.5 + 0.5) * screen_w;
            float sy2 = (clip.y * inv_w * 0.5 + 0.5) * screen_h;
            float screen_r = r / clip.w * screen_w * 0.5;
            if (sx2 + screen_r < sx || sx2 - screen_r > ex ||
                sy2 + screen_r < sy || sy2 - screen_r > ey) continue;
        }
        g_grid.Store((gb + offset + count) * 4u, li);
        count++;
    }
    g_grid.Store((ci * 2u) * 4u, offset);
    g_grid.Store((ci * 2u + 1u) * 4u, count);
}

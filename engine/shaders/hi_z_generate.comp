#version 450
layout(local_size_x = 64) in;

/*
 * R436: Segmented (chunked) Hi-Z pyramid generation — replaces the old
 * one-dispatch-per-mip chain (10 dispatches + 10 barriers at 1280x720).
 *
 * Why segmented instead of full FidelityFX SPD:
 *   - Full SPD needs a global cross-workgroup barrier (atomic spin). A spin
 *     loop risks deadlock whenever workgroups are not co-resident, and the
 *     Vulkan RHI exposes only 4 storage-image bindings to compute
 *     (storage_image_layout, rhi_vk.c), far fewer than SPD's per-mip image
 *     array. Both make full SPD a poor fit here.
 *   - Instead each dispatch generates a chunk of up to 4 consecutive mip
 *     levels. Within a chunk every output texel is reduced DIRECTLY from the
 *     chunk's input texture (an output texel of relative mip k covers the
 *     2^(k+1) x 2^(k+1) input block), so there is no cross-workgroup or even
 *     cross-thread dependency: no shared memory, no barrier(), no spin.
 *   - Only ONE memory barrier separates chunks (chunk c+1 samples the last
 *     mip written by chunk c). 10 levels -> 3 dispatches + 3 barriers.
 *
 * The shader is chunk-agnostic: chunk 0 reads the scene depth buffer, later
 * chunks read the previous mip through a single-mip sampler view. The chunk's
 * first output mip always downsamples its input by exactly 2x.
 *
 * Set/binding convention from the Vulkan RHI (unchanged):
 *   set=2 (sampler_mip_layout) holds COMBINED_IMAGE_SAMPLER bindings.
 *   set=1 (storage_image_layout) holds STORAGE_IMAGE bindings (4 max).
 * OpenGL GLSL rejects the set= qualifier, so it is only emitted under VULKAN;
 * the binding= numbers are identical on both backends.
 */
#ifdef VULKAN
layout(set = 2, binding = 0) uniform sampler2D u_input;
layout(set = 1, binding = 0, r32f) uniform writeonly image2D u_out0;
layout(set = 1, binding = 1, r32f) uniform writeonly image2D u_out1;
layout(set = 1, binding = 2, r32f) uniform writeonly image2D u_out2;
layout(set = 1, binding = 3, r32f) uniform writeonly image2D u_out3;
#else
layout(binding = 0) uniform sampler2D u_input;
layout(binding = 0, r32f) uniform writeonly image2D u_out0;
layout(binding = 1, r32f) uniform writeonly image2D u_out1;
layout(binding = 2, r32f) uniform writeonly image2D u_out2;
layout(binding = 3, r32f) uniform writeonly image2D u_out3;
#endif

#ifdef VULKAN
layout(push_constant) uniform PushConstants {
    /* xy = pixel size of the chunk's FIRST output mip,
     * z  = number of output mips in this chunk (1..4),
     * w  = unused. */
    vec4 output_size;
} pc;
#else
uniform vec4 pc_output_size;
#define pc_output_size_v pc_output_size
#endif

void main() {
#ifdef VULKAN
    vec4 params = pc.output_size;
#else
    vec4 params = pc_output_size_v;
#endif

    ivec2 first_size = max(ivec2(params.xy), ivec2(1));
    int   mip_count  = int(params.z + 0.5);
    ivec2 in_size    = textureSize(u_input, 0);

    /* Sizes of the (up to) 4 output mips; floor-shift matches both the
     * Vulkan/GL mip-chain sizes and the CPU-side dispatch sizing. */
    ivec2 sz0 = max(first_size,      ivec2(1));
    ivec2 sz1 = max(first_size >> 1, ivec2(1));
    ivec2 sz2 = max(first_size >> 2, ivec2(1));
    ivec2 sz3 = max(first_size >> 3, ivec2(1));

    /* Thread ranges: threads [0,n0) -> mip 0, [n0,n1) -> mip 1, ... */
    int n0 = sz0.x * sz0.y;
    int n1 = n0 + ((mip_count > 1) ? sz1.x * sz1.y : 0);
    int n2 = n1 + ((mip_count > 2) ? sz2.x * sz2.y : 0);
    int n3 = n2 + ((mip_count > 3) ? sz3.x * sz3.y : 0);

    int tid = int(gl_GlobalInvocationID.x);
    if (tid >= n3) return;

    int   k;
    ivec2 sz;
    int   t;
    if (tid < n0)      { k = 0; sz = sz0; t = tid;      }
    else if (tid < n1) { k = 1; sz = sz1; t = tid - n0; }
    else if (tid < n2) { k = 2; sz = sz2; t = tid - n1; }
    else               { k = 3; sz = sz3; t = tid - n2; }
    ivec2 pos = ivec2(t % sz.x, t / sz.x);

    /*
     * Max-depth reduction (farthest point; reversed-Z would use min), same
     * conservative-occlusion contract as before. Output texel (x,y) of
     * relative mip k covers input block [pos*R, pos*R+R). For odd input
     * sizes the last row/column absorbs the remainder texels, so coverage is
     * always a superset of the true cell footprint — never less conservative
     * than the old 4-tap nearest sampling (which could skip edge texels).
     */
    int   R    = 1 << (k + 1);
    ivec2 base = pos * R;
    ivec2 hi   = base + ivec2(R);
    if (pos.x == sz.x - 1) hi.x = in_size.x;
    if (pos.y == sz.y - 1) hi.y = in_size.y;
    hi = min(hi, in_size);

    float max_depth = 0.0;
    for (int y = base.y; y < hi.y; y++) {
        for (int x = base.x; x < hi.x; x++) {
            max_depth = max(max_depth, texelFetch(u_input, ivec2(x, y), 0).r);
        }
    }

    vec4 v = vec4(max_depth, 0.0, 0.0, 0.0);
    if (k == 0)      imageStore(u_out0, pos, v);
    else if (k == 1) imageStore(u_out1, pos, v);
    else if (k == 2) imageStore(u_out2, pos, v);
    else             imageStore(u_out3, pos, v);
}

+++ b/qnx/BUILD.gn
@@ -0,0 +1,49 @@
+import("//build/toolchain/gcc_toolchain.gni")
+
+declare_args() {
+  qnx_sdp_dir = ""
+  qnx_host = ""
+}
+
+assert(qnx_sdp_dir != "", "qnx_sdp_dir must name the QNX SDP root")
+assert(qnx_host != "", "qnx_host must name the QNX SDP host directory")
+
+template("qnx_gcc_toolchain") {
+  gcc_toolchain(target_name) {
+    prefix = "$qnx_host/usr/bin"
+    cc = "$prefix/nto${invoker.bin_cpu}-gcc"
+    cxx = "$prefix/nto${invoker.bin_cpu}-g++"
+    ar = "$prefix/nto${invoker.bin_cpu}-ar"
+    ld = cxx
+    readelf = "$prefix/nto${invoker.bin_cpu}-readelf"
+    nm = "$prefix/nto${invoker.bin_cpu}-nm"
+    extra_cppflags = "-D_QNX_SOURCE -fPIC"
+    if (defined(invoker.libcxx_has_no_asan) && invoker.libcxx_has_no_asan) {
+      extra_cppflags += " -D_LIBCPP_HAS_NO_ASAN"
+    }
+    extra_cxxflags = "-Wno-error=alloc-size-larger-than= -Wno-error=array-bounds -Wno-error=stringop-overflow"
+    toolchain_args = {
+      current_cpu = invoker.current_cpu
+      current_os = "qnx"
+      is_clang = false
+      use_remoteexec = false
+      use_custom_libcxx = false
+    }
+  }
+}
+
+qnx_gcc_toolchain("x64") {
+  bin_cpu = "x86_64"
+  current_cpu = "x64"
+}
+
+qnx_gcc_toolchain("x64_asan") {
+  bin_cpu = "x86_64"
+  current_cpu = "x64"
+  libcxx_has_no_asan = true
+}
+
+qnx_gcc_toolchain("arm64") {
+  bin_cpu = "aarch64"
+  current_cpu = "arm64"
+}
--- a/src/common/system_utils_qnx.cpp
+++ b/src/common/system_utils_qnx.cpp
@@ -0,0 +1,59 @@
+#include "common/debug.h"
+#include "common/system_utils.h"
+
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/process.h>
+#include <time.h>
+
+namespace angle
+{
+std::string GetExecutablePath()
+{
+    const char *command = _cmdname(nullptr);
+    if (command == nullptr)
+    {
+        return "";
+    }
+
+    char path[PATH_MAX];
+    if (realpath(command, path) != nullptr)
+    {
+        return path;
+    }
+    return command;
+}
+
+std::string GetExecutableDirectory()
+{
+    std::string executablePath = GetExecutablePath();
+    size_t lastPathSepLoc = executablePath.find_last_of("/");
+    return lastPathSepLoc == std::string::npos ? "" : executablePath.substr(0, lastPathSepLoc);
+}
+
+const char *GetSharedLibraryExtension()
+{
+    return "so";
+}
+
+double GetCurrentSystemTime()
+{
+    struct timespec currentTime;
+    clock_gettime(CLOCK_MONOTONIC, &currentTime);
+    return currentTime.tv_sec + currentTime.tv_nsec * 1e-9;
+}
+
+uint64_t GetCurrentSystemTimeNs()
+{
+    struct timespec currentTime;
+    clock_gettime(CLOCK_MONOTONIC, &currentTime);
+    return static_cast<uint64_t>(currentTime.tv_sec) * 1000'000'000 + currentTime.tv_nsec;
+}
+
+void SetCurrentThreadName(const char *name)
+{
+    ASSERT(strlen(name) < 16);
+    pthread_setname_np(pthread_self(), name);
+}
+}  // namespace angle

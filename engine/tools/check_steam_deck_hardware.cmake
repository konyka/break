if(NOT DEFINED OUT)
    message(FATAL_ERROR "OUT is required")
endif()
set(hardware_ok false)
set(hardware_reason "")

function(normalize_id text out_var)
    if(NOT "${text}" MATCHES "^(0[xX][0-9a-fA-F]+|[0-9]+)$")
        set(${out_var} "" PARENT_SCOPE)
        return()
    endif()
    math(EXPR value "${text}" OUTPUT_FORMAT DECIMAL)
    set(${out_var} "${value}" PARENT_SCOPE)
endfunction()

if(NOT DEFINED RECEIPT OR NOT EXISTS "${RECEIPT}")
    set(hardware_reason receipt-missing)
else()
    file(READ "${RECEIPT}" json)
    normalize_id("${EXPECTED_VENDOR_ID}" expected_vendor)
    normalize_id("${EXPECTED_DEVICE_ID}" expected_device)
    if("${expected_vendor}" STREQUAL "" OR "${expected_device}" STREQUAL "" OR
            expected_vendor EQUAL 0 OR expected_device EQUAL 0)
        set(hardware_reason missing-config)
    else()
        string(JSON device_type ERROR_VARIABLE type_error GET "${json}" device_type)
        if(NOT "${type_error}" STREQUAL "NOTFOUND" OR "${device_type}" STREQUAL "")
            set(hardware_reason unknown-not-comparable)
        elseif(device_type STREQUAL "CPU")
            set(hardware_reason cpu-not-comparable)
        elseif(device_type STREQUAL "VIRTUAL")
            set(hardware_reason virtual-not-comparable)
        elseif(device_type STREQUAL "OTHER")
            set(hardware_reason other-not-comparable)
        elseif(NOT device_type MATCHES "^(INTEGRATED|DISCRETE)$")
            set(hardware_reason unknown-not-comparable)
        else()
            string(JSON actual_vendor ERROR_VARIABLE vendor_error GET "${json}" vendor_id)
            string(JSON actual_device ERROR_VARIABLE device_error GET "${json}" device_id)
            if(NOT "${vendor_error}" STREQUAL "NOTFOUND")
                set(hardware_reason vendor-mismatch)
            elseif(NOT "${device_error}" STREQUAL "NOTFOUND")
                set(hardware_reason device-mismatch)
            else()
                normalize_id("${actual_vendor}" actual_vendor_number)
                normalize_id("${actual_device}" actual_device_number)
                if("${actual_vendor_number}" STREQUAL "" OR NOT actual_vendor_number EQUAL expected_vendor)
                    set(hardware_reason vendor-mismatch)
                elseif("${actual_device_number}" STREQUAL "" OR NOT actual_device_number EQUAL expected_device)
                    set(hardware_reason device-mismatch)
                else()
                    set(hardware_ok true)
                    set(hardware_reason ok)
                endif()
            endif()
        endif()
    endif()
endif()

file(WRITE "${OUT}" "hardware_ok=${hardware_ok}\nhardware_reason=${hardware_reason}\n")
message(STATUS "hardware_ok=${hardware_ok}; reason=${hardware_reason}")
if(REQUIRE AND NOT hardware_ok)
    message(FATAL_ERROR "Steam Deck hardware requirement failed: ${hardware_reason}")
endif()
